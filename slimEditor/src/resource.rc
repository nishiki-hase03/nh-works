#include <windows.h>

#define MAINICON 1
#define IDC_ESCAPE 101

// Icon
MAINICON ICON "icon.ico"

// Manifest
1 24 "slimEditor.manifest"

// Accelerator Table
IDR_ACCELERATOR ACCELERATORS
BEGIN
    VK_ESCAPE, IDC_ESCAPE, VIRTKEY
    VK_ESCAPE, IDC_ESCAPE, VIRTKEY, SHIFT
END

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Self-employed"
            VALUE "FileDescription",  "Slim Editor - Simple Text Editor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "slimEditor"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "slimEditor.exe"
            VALUE "ProductName",      "Slim Editor"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
